generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum IntakeStatus {
  received
  in_progress
  completed
  rejected
}

enum UserRole {
  user
  staff
  admin
  super_admin
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(uuid())
  referenceId String        @unique
  name        String
  email       String
  phone       String
  machineType String
  preferredDate String
  message     String
  status      BookingStatus @default(pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MachineIntake {
  id                String       @id @default(uuid())
  referenceId       String       @unique
  customerName      String
  email             String
  phone             String
  brand             String
  model             String
  machineType       String
  issueSummary      String
  maxRepairAmount   Int
  addCleaningService Boolean
  acceptedTerms     Boolean
  photoCount        Int          @default(0)
  photoUrls         String[]
  signatureDataUrl  String?
  timeSpentMs       Int          @default(0)
  pdfUrl            String?
  price             Int?
  engineerNotes     String?
  status            IntakeStatus @default(received)
  closedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           UserRole  @default(user)
  isActive           Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpiry  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorEmail  String
  targetId    String
  targetEmail String
  action      String
  detail      String
  createdAt   DateTime @default(now())
}

model IntakeChangeLog {
  id            String   @id @default(uuid())
  intakeId      String
  referenceId   String   @default("")
  actorEmail    String   @default("system")
  action        String   @default("updated")
  field         String?
  oldValue      String?
  newValue      String?
  createdAt     DateTime @default(now())
}
